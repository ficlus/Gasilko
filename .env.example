# Reference inventory only. M0 launches with no environment values.
# Do not copy all sections into a client environment. Use only relevant names.

# Web PUBLIC configuration (browser-visible; web/.env.local in later milestones)
NEXT_PUBLIC_SUPABASE_URL=<public-project-url>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<public-publishable-key>

# Android PUBLIC configuration (future explicit Gradle mapping only)
ANDROID_SUPABASE_URL=<public-project-url>
ANDROID_SUPABASE_PUBLISHABLE_KEY=<public-publishable-key>

# SERVER ONLY: trusted backend secret store; never NEXT_PUBLIC_ or Android
SUPABASE_SECRET_KEY=<server-only-secret-key>

# Supabase CLI only; not needed for local start/reset/test
SUPABASE_PROJECT_REF=<remote-project-reference>
SUPABASE_ACCESS_TOKEN=<cli-only-access-token>
SUPABASE_DB_PASSWORD=<cli-only-database-password>

# Future Firebase PUBLIC project configuration (not used in M0)
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_ANDROID_APP_ID=<firebase-android-app-id>
# Future Firebase SERVER ONLY, secret-store reference rather than JSON contents
FIREBASE_ADMIN_CREDENTIALS_PATH=<server-only-credential-file-path>
